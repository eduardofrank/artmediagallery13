#### REDIRECTION FOR DETAIL PAGES WHEN CALLED ALONE ###
[page["uid"] == 22]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,13,404
[END]

[page["uid"] == 23]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,12,404
[END]

[page["uid"] == 24]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,13,404
[END]

[page["uid"] == 25]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,13,404
[END]

[page["uid"] == 27]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,14,404
[END]

[page["uid"] == 28]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,12,404
[END]

[page["uid"] == 30]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,12,404
[END]

[page["uid"] == 33]
    plugin.tx_news.settings.detail.errorHandling = redirectToPage,15,404
[END]

page {
    10 = FLUIDTEMPLATE
    10 {
        dataProcessing {
            30 {
                special = rootline
                special.range = 1|-1
                includeNotInMenu = 1
                as = breadcrumb
                if {
                    value = {$page.theme.breadcrumb.enableLevel}
                    value {
                        insertData = 1
                        prioriCalc = 1
                        stdWrap.wrap = |-1
                    }
                    isGreaterThan {
                        data = level
                    }
                }
                dataProcessing {
                    10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                    10 {
                        references.fieldName = nav_icon
                        as = icon
                    }
                }
            }
        }
    }
}

page {
    headerData {
        2024 = FLUIDTEMPLATE
        2024 {
            template = TEXT
            template.value (
<link rel="apple-touch-icon" sizes="180x180" href="{f:uri.resource(path: 'Icons/apple-touch-icon.png', extensionName: 'artmediagallery13')}">
<link rel="icon" type="image/png" sizes="32x32" href="{f:uri.resource(path: 'Icons/favicon-32x32.png', extensionName: 'artmediagallery13')}">
<link rel="icon" type="image/png" sizes="16x16" href="{f:uri.resource(path: 'Icons/favicon-16x16.png', extensionName: 'artmediagallery13')}">
<meta name="msapplication-TileColor" content="#da532c">
<meta name="theme-color" content="#ffffff">
            )
        }
    }
}

lib.contentElement.settings.responsiveimages.variants {
    default {
        breakpoint = 1200
        width = 1100
        sizes {
            1\.5x {
                multiplier = 1.5
            }
            2x {
                multiplier = 2
            }
        }
    }
    large {
        breakpoint = 992
        width = 920
        sizes {
            1\.5x {
                multiplier = 1.5
            }
            2x {
                multiplier = 2
            }
        }
    }
    medium {
        breakpoint = 768
        width = 680
        sizes {
            1\.5x {
                multiplier = 1.5
            }
            2x {
                multiplier = 2
            }
        }
    }
    small {
        breakpoint = 576
        width = 500
        sizes {
            1\.5x {
                multiplier = 1.5
            }
            2x {
                multiplier = 2
            }
        }
    }
    extrasmall {
        breakpoint = unset
        width = 374
        sizes {
            1\.5x {
                multiplier = 1.5
            }
            2x {
                multiplier = 2
            }
        }
    }
}

# Restore Bootstrap Package content element rendering after optional fluid-styled-content set
@import 'EXT:bootstrap_package/Configuration/TypoScript/ContentElement/setup.typoscript'
