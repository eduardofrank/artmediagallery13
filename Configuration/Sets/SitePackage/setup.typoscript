##############
#### PAGE ####
##############
page {
    includeCSSLibs {
        adobewebfont = https://use.typekit.net/pcy8rgj.css
    }
    includeCSS {
        theme = EXT:artmediagallery13/Resources/Public/Scss/Theme/theme.scss
        gallery_layout = EXT:artmediagallery13/Resources/Public/Css/gallery.css
    }

    includeJSLibs {

    }

    includeJS {

    }

    includeJSFooterlibs {
        bootstrap_lightbox = EXT:artmediagallery13/Resources/Public/JavaScript/lightbox.js
    }

    includeJSFooter {
        artmediagallery13_scripts = EXT:artmediagallery13/Resources/Public/JavaScript/main.js
    }
}

################################
#### ADDED BY EDUARDO FRANK ####
################################
config.admPanel = 0
config.contentObjectExceptionHandler = 0

#### FORM ###
plugin.tx_form.settings.yamlConfigurations {
    100 = EXT:artmediagallery13/Configuration/Yaml/FormSetup.yaml
}

module.tx_form.settings.yamlConfigurations {
    100 = EXT:artmediagallery13/Configuration/Yaml/FormSetup.yaml
}

#### NEWS ####
config.recordLinks.tx_news {
    typolink {
        parameter.stdWrap.cObject = CONTENT
        parameter.stdWrap.cObject {
            table = sys_category
            select {
                pidInList = 31
                max = 1
                selectFields = sys_category.single_pid AS detailPid
                join = sys_category_record_mm ON sys_category_record_mm.uid_local = sys_category.uid
                where = sys_category_record_mm.tablenames='tx_news_domain_model_news' AND sys_category_record_mm.uid_foreign = {field: uid}
                where.insertData = 1
                andWhere.stdWrap.intVal = 1
                andWhere.stdWrap.stripHtml = 1
            }
            renderObj = TEXT
            renderObj.field = detailPid
            renderObj.wrap = |
        }
        additionalParams.data = field:uid
        additionalParams.wrap = &tx_news_pi1[news]=|
        useCacheHash = 0
    }
}

plugin.tx_news.settings.list.media.image.width = 900

plugin.tx_news.view {
    templateRootPaths {
        20 = EXT:artmediagallery13/Resources/Private/Templates/Styles/Twb/Templates/
    }
    partialRootPaths {
        20 = EXT:artmediagallery13/Resources/Private/Templates/Styles/Twb/Partials/
    }
    layoutRootPaths {
        20 = EXT:artmediagallery13/Resources/Private/Templates/Styles/Twb/Layouts/
    }
}

#### SEO CONFIGURATION ###
plugin.tx_seo.config {
    xmlSitemap {
        sitemaps {
            exhibit {
                provider = TYPO3\CMS\Seo\XmlSitemap\RecordsXmlSitemapDataProvider
                config {
                    table = tx_news_domain_model_news
                    sortField = sorting
                    lastModifiedField = tstamp
                    pid = 96
                    recursive = 2
                    url {
                        pageId = 22
                        fieldToParameterMap {
                            uid = tx_news_pi1[news]
                        }
                        additionalGetParameters {
                            tx_news_pi1.controller = News
                            tx_news_pi1.action = detail
                        }
                        useCacheHash = 1
                    }
                }
            }
            statement {
                provider = TYPO3\CMS\Seo\XmlSitemap\RecordsXmlSitemapDataProvider
